{
  "expo": {
    "name": "Second Brain",
    "slug": "second-brain-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.secondbrain.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.secondbrain.app",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "targetSdkVersion": 34,
      "minSdkVersion": 24,
      "compileSdkVersion": 34
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "secondbrain",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Second Brain to access your camera to scan QR codes."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {}
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "284b6b82-c332-4e3a-b625-b6a42eb293cc"
      }
    },
    "owner": "cvpilot"
  }
}
